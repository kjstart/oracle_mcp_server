# Oracle MCP Server v2.0.0 Configuration
# Copy this file to config.yaml and modify as needed
# Author: Alvin Liu — https://alvinliu.com
# Github: https://github.com/kjstart/cursor_oracle_mcp_server

# Oracle Database Connection (required). Name -> DSN.
# Pass "connection" in every database tool call (see list_connections).
oracle:
  # Default true: startup/list_connections never connect; check/reconnect the selected connection on each operation.
  # false: connect at startup, retry failures on listing and maintain SSH connections in the background.
  lazy_mode: true
  connections:
    database1: "user/pass@//host:1521/ORCL"
#    database2: "user/pass@//host2:1521/ORCL"
  # Optional: connection name -> security profile name ("default" or a key of security_profiles).
  # Connections not listed here use the top-level "security" section.
#  connection_security:
#    database2: strict
  # Optional: independent SSH tunnel for each connection; omitted connections connect directly.
  # SSH settings (including passwords/passphrases) remain plaintext; only connections DSNs are encrypted.
  # Local ports are allocated automatically. Relative paths resolve from this config directory.
#  connection_ssh:
#    database1:
#      host: bastion.example.com         # SSH endpoint: bastion, NOT the database server
#      port: 22                         # default 22
#      username: oracle
#      private_key_file: '~/.ssh/id_ed25519'
#      # private_key_passphrase: 'plain-passphrase'
#      # private_key_passphrase_env: SSH_KEY_PASSPHRASE  # alternative to plaintext
#      # password: 'plain-ssh-password'                # alternative to private_key_file
#      # password_env: SSH_PASSWORD                    # alternative to key/plain password
#      # known_hosts_file: /custom/known_hosts # optional override; defaults to ~/.ssh/known_hosts
#      remote_host: db.internal         # database TCP target, resolved/accessed FROM bastion
#      remote_port: 1521                # default 1521
# Connection string format: user/password@//host:port/service_name

# Security Settings
security:
  # How to match danger_keywords: "whole_text" (default) or "tokens"
  # whole_text: case-insensitive whole-word matching, including strings/comments;
  # identifiers such as request_delete and created_at do not match delete/create.
  # tokens: exact token match after stripping strings/comments (e.g. "created_at" does not match "create")
  danger_keyword_match: "whole_text"

  # List of keywords that trigger user confirmation
  # Case-insensitive, supports multi-word keywords (e.g., "alter system", "execute immediate")
  danger_keywords:
    - truncate
    - drop
    - alter
    - shutdown
    - grant
    - delete
    - revoke
    - create
    - update
    - execute immediate
    - replace
    - call

  # If true, all DDL statements (CREATE, DROP, ALTER, etc.) require confirmation
  # even if they don't match danger_keywords
  require_confirm_for_ddl: true

# Optional: named security profiles, same fields as "security". Omitted fields use built-in defaults.
# Referenced by name from oracle.connection_security. The name "default" is reserved.
#security_profiles:
#  strict:
#    danger_keyword_match: "tokens"
#    danger_keywords: [drop, delete, update, insert, alter]
#    require_confirm_for_ddl: true

# Logging Settings
logging:
  # Enable audit logging
  audit_log: true
  # When true, log one line per execute_sql: [debug] Execute Action: <type>, Connection: <name> (Cursor adds timestamp)
  verbose_logging: true

  # Path to audit log file (relative to config directory or absolute path)
  log_file: "audit.log"
  # SSH/connectivity errors only; separate from SQL audit log. Relative to config directory.
  error_log_file: "error.log"
